{
  "name": "devloop-mcp",
  "version": "0.10.1",
  "mcpName": "io.github.vincentvella/devloop",
  "description": "Unified dev-loop: one MCP server exposing browser control + dev-server logs on a correlated timeline. Headless (stdio) or Electron cockpit (HTTP).",
  "type": "module",
  "main": "out/main.cjs",
  "bin": {
    "devloop-mcp": "dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agents",
    "devtools",
    "browser",
    "browser-automation",
    "puppeteer",
    "electron",
    "logs",
    "dev-server",
    "observability",
    "expo",
    "react-native",
    "correlated-timeline",
    "repro"
  ],
  "author": "Vincent Vella",
  "license": "MIT",
  "homepage": "https://devloop.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentvella/devloop.git"
  },
  "bugs": {
    "url": "https://github.com/vincentvella/devloop/issues"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "workspaces": [
    "web"
  ],
  "overrides": {
    "postcss": "^8.5.20"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "site:dev": "bun --filter=devloop-site run dev",
    "site:build": "bun --filter=devloop-site run build",
    "site:start": "bun --filter=devloop-site run start",
    "test": "bun test",
    "test:e2e": "bun run test-smoke.ts && bun run app:selftest",
    "test:daemon": "bun run mcp:build && bun run scripts/test-daemon.ts",
    "test:autoconnect": "bun run mcp:build && bun run scripts/test-daemon-autoconnect.ts",
    "test:mcporter": "bun run mcp:build && bun run scripts/test-mcporter.ts",
    "tools:audit": "bun run scripts/audit-tools.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:all": "bun run check && bun run typecheck && bun test && bun run test-smoke.ts && bun run app:selftest",
    "typecheck": "tsc --noEmit && tsc -p cockpit/renderer/tsconfig.json && tsc -p test/gui/tsconfig.json",
    "mcp:build": "bun run scripts/build-mcp.ts",
    "app:build": "bun run cockpit/build.ts",
    "app": "bun run cockpit/dev.ts",
    "app:once": "bun run app:build && electron out/main.cjs",
    "app:selftest": "bun run app:build && DEVLOOP_SELFTEST=1 electron out/main.cjs",
    "dist": "bun run app:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "bun run app:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "bun run app:build && electron-builder --win",
    "dist:linux": "bun run app:build && electron-builder --linux",
    "prepublishOnly": "bun run mcp:build",
    "app:gui": "bun run app:build && node test/gui/run.ts",
    "app:shots": "bun run app:build && node test/gui/screenshots.ts",
    "rn:smoke": "bun run scripts/rn-harness.ts",
    "android:smoke": "bun run app:build && node test/gui/scenarios/androidLive.ts"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "puppeteer": "^25.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tailwindcss/cli": "^4.3.2",
    "@types/bun": "latest",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "playwright-core": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serve-sim": "0.1.44",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "zustand": "^5.0.14"
  }
}
